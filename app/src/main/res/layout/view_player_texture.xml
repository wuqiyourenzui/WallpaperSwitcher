<?xml version="1.0" encoding="utf-8"?>
<!--
  网盘在线视频播放器：刻意用 texture_view 而不是默认的 surface_view。
  背景：MIUI 上把 4K HEVC 视频放进 Dialog 里的 SurfaceView 播放时，App 窗口会被顶到
  后台（真机复现，无崩溃日志）。TextureView 走的是普通 View 纹理合成，不额外申请
  SurfaceView 的独立图层，用来验证"是不是 SurfaceView + MIUI 窗口策略"的锅。
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/online_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="true"
    app:show_buffering="never"
    app:resize_mode="fit" />
